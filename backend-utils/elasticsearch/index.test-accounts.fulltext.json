{
  "settings": {
    "analysis": {
      "analyzer": {
        "ik_smart_analyzer": { "tokenizer": "ik_smart" }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "firstname": { "type": "text", "copy_to": "fulltext" },
      "lastname":  { "type": "text", "copy_to": "fulltext" },
      "email":     { "type": "keyword", "copy_to": "fulltext" },
      "phone":     { "type": "keyword", "copy_to": "fulltext" },
      "labels":    { "type": "keyword", "copy_to": "fulltext" },

      "fulltext":  { "type": "text" },
      "level":     { "type": "keyword" },
      "createdAt": { "type": "date", "index": true, "format": "strict_date_optional_time||epoch_millis" },
      "updatedAt": { "type": "date", "index": true, "format": "strict_date_optional_time||epoch_millis" }
    }
  }
}
